#!/bin/sh
set -eu
systemd-manager-tui --version | grep -Fx 'systemd-manager-tui 1.3.0'
help=$(systemd-manager-tui --help)
printf '%s\n' "$help" | grep -F -- '--operation-timeout-secs'
printf '%s\n' "$help" | grep -F -- '--no-notifications'
if systemd-manager-tui --operation-timeout-secs 0 > /dev/null 2>&1; then
    echo 'Invalid timeout was accepted' >&2
    exit 1
fi
